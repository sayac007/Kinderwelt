config_version=5
[application]
config/name="Kinderwelt"
config/version="0.1.0"
config/icon="res://assets/icons/kinderwelt.svg"
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=900
window/size/viewport_height=700
window/stretch/mode="disabled"
window/handheld/orientation=6
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.10, 0.18, 1)
textures/vram_compression/import_etc2_astc=true
