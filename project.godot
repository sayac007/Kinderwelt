config_version=5
[application]
config/name="Kinderwelt"
config/version="0.4.0"
config/icon="res://assets/icons/kinderwelt.svg"
boot_splash/bg_color=Color(0.984, 0.973, 0.941, 1)
boot_splash/show_image=false
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=420
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation=6
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.984, 0.973, 0.941, 1)
textures/vram_compression/import_etc2_astc=true
